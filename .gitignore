# Install artifacts the gateway writes into an installed copy of this app.
# Committing them causes stale-version display and path bugs on other machines.
/build
/release-info
.app_secret
app-crons.json
installed.json
data/

# Review evidence belongs to the e2e-evidence workflow artifact, never to git:
# this app's whole directory is copied into every user's install.
/docs/e2e/
/e2e-shots/

# Python
__pycache__/
*.py[cod]
