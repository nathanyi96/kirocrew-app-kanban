# Install artifacts the gateway writes into an installed copy of this app.
# Committing them causes stale-version display and path bugs on other machines.
/build
/release-info
.app_secret
app-crons.json
installed.json
data/

# Temporary review evidence is committed under docs/e2e/<pr-number>/ until a
# durable PR attachment workflow is adopted.
/e2e-shots/

# Python
__pycache__/
*.py[cod]
