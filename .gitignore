# Install artifacts the gateway writes into an installed copy of this app.
# Committing them causes stale-version display and path bugs on other machines.
/build
# ui/dist is shipped: registry installs do not build the nested ui/package.json.
/ui/node_modules
/release-info
.app_secret
app-crons.json
installed.json
data/

# Review evidence is uploaded to PR descriptions or retained as CI artifacts.
/docs/e2e/
/e2e-shots/

# Python
__pycache__/
*.py[cod]
